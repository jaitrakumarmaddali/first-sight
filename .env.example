# First Sight Environment Configuration
DATABASE_URL="file:./dev.db"

# Google AI Gemini API Key (optional - full intelligent mock fallback included for demo)
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key"

# AI Model Configuration
GEMINI_FLASH_MODEL="gemini-3.8-flash"
GEMMA_ACTIVITY_MODEL="gemma-4-e4b"
GEMINI_LIVE_MODEL="gemini-3.8-live"
GEMINI_TTS_MODEL="gemini-3.8-flash-tts"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
GEMINI_VISION_MODEL="gemini-omni-1.1-flash"

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
